{
  "name": "ai-document-assistant-desktop",
  "version": "2.0.0",
  "description": "Commercial Offline Desktop AI Document Assistant with Sandboxed Sidecar Security Engine",
  "author": "Senior Systems Integration Architect",
  "keywords": [
    "security",
    "sandboxed",
    "privacy",
    "electron",
    "electron-builder",
    "fastapi-sidecar",
    "nsis-installer",
    "dmg-installer",
    "offline-rag"
  ],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd ../frontend && npm run build",
    "build:backend": "cd ../backend && pyinstaller rag_backend.spec --noconfirm",
    "pack": "npx electron-builder --dir",
    "dist": "npx electron-builder --win dir"
  },
  "build": {
    "appId": "com.aidocumentassistant.app",
    "productName": "AI Document Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/rag_backend",
        "to": "rag_backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend_dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AI Document Assistant",
      "uninstallDisplayName": "AI Document Assistant"
    }
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
